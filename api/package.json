{
  "name": "@taskmanager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "test": "dotenv -e ../docker/.env.test -- vitest",
    "test:coverage": "dotenv -e ../docker/.env.test -- vitest run --coverage",
    "test:prisma": "node prisma-test.js",
    "test:e2e": "dotenv -e ../docker/.env.test -- node --import tsx ./node_modules/@cucumber/cucumber/bin/cucumber.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:scan": "npm audit --audit-level=moderate || true",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@hono/node-server": "^1.14.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "hono": "^4.7.10",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.1.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prisma": "^6.12.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.7"
  }
}
